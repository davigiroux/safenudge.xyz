# Grafana Cloud stack details (Connections > Hosted logs / Hosted Prometheus).
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=
# Access policy token with only logs:write and metrics:write.
GRAFANA_CLOUD_TOKEN=
# safenudge-mainnet and mainnet for mainnet.
MICROSCOPE_DEPLOYMENT=safenudge-devnet
MICROSCOPE_ENV=devnet
