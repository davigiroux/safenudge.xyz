[Unit]
Description=SafeNudge watchdog (upgrade authority, unsettled groups)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=safenudge-mon
Group=safenudge-mon
EnvironmentFile=/etc/safenudge/watchdog.env
Environment=STATE_PATH=/var/lib/safenudge-watchdog/state.json NODE_NO_WARNINGS=1
StateDirectory=safenudge-watchdog
ExecStart=/opt/safenudge/node/bin/node /opt/safenudge/watchdog/watchdog.js
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M
